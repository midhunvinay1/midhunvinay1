[Unit]
Description=tradebot daily trading run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tradebot
WorkingDirectory=/opt/tradebot
EnvironmentFile=/opt/tradebot/.env
# Change --broker to robinhood only after the paper-trading go/no-go (docs/RUNBOOK.md).
ExecStart=/opt/tradebot/bin/tradebot run --config /opt/tradebot/configs/config.yaml --broker alpaca-paper
TimeoutStartSec=20min
